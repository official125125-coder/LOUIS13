<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#02050c">

  <title>LOUIS13 | Royal Game Prestige</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="style.css">
</head>

<body>

  <!-- BACKGROUND -->
  <div class="bg-effects">
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
    <div id="particles"></div>
  </div>


  <!-- HEADER -->
  <header class="header">

    <div class="header-inner">

      <a href="#home" class="brand">

        <img
          src="image/logo.png"
          alt="LOUIS13"
          class="brand-logo"
        >

        <div class="brand-name">
          <strong>LOUIS<span>13</span></strong>
          <small>ROYAL GAME PRESTIGE</small>
        </div>

      </a>


      <div class="header-status">
        <i></i>
        ONLINE 24/7
      </div>

    </div>

  </header>


  <main>

    <!-- WELCOME -->
    <section class="welcome-section" id="home">

      <div class="welcome-content">

        <p class="small-title">
          WELCOME TO
        </p>

        <h1>
          LOUIS<span>13</span>
        </h1>

        <div class="royal-divider">
          <span></span>
          <b>◆</b>
          <span></span>
        </div>

        <h2>
          ROYAL GAME PRESTIGE
        </h2>

        <p class="welcome-text">
          Pengalaman premium, servis pantas dan
          sokongan profesional 24/7.
        </p>

      </div>

    </section>


    <!-- PROMOTION -->
    <section class="section" id="promotion">

      <div class="section-title">

        <p>LOUIS13 EXCLUSIVE</p>

        <h2>
          PROMOSI <span>ROYAL</span>
        </h2>

        <div class="title-line">
          <span></span>
          ◆
          <span></span>
        </div>

      </div>


      <div class="promo-grid">

        <div class="promo-card">

          <div class="promo-icon">
            ♛
          </div>

          <small>
            WELCOME BONUS
          </small>

          <strong>
            30%
          </strong>

          <p>
            Bonus Selamat Datang
          </p>

        </div>


        <div class="promo-card">

          <div class="royal-tag">
            ROYAL
          </div>

          <div class="promo-icon">
            ◆
          </div>

          <small>
            DAILY 1ST DEPOSIT
          </small>

          <strong>
            20%
          </strong>

          <p>
            Bonus Deposit Harian
          </p>

        </div>


        <div class="promo-card">

          <div class="promo-icon">
            ★
          </div>

          <small>
            UNLIMITED DEPOSIT
          </small>

          <strong>
            10%
          </strong>

          <p>
            Bonus Deposit
          </p>

        </div>


        <div class="promo-card">

          <div class="promo-icon">
            ♜
          </div>

          <small>
            WEEKLY
          </small>

          <strong class="rebate">
            REBATE
          </strong>

          <p>
            Setiap Hari Isnin
          </p>

        </div>

      </div>

    </section>


    <!-- GROUP CHANNEL -->
    <section class="section channel-section">

      <div class="section-title">

        <p>
          OFFICIAL COMMUNITY
        </p>

        <h2>
          GROUP <span>CHANNEL</span>
        </h2>

        <div class="title-line">
          <span></span>
          ◆
          <span></span>
        </div>

      </div>


      <div class="channel-box">

        <div class="channel-decoration">
          ◆
        </div>


        <div class="channel-text">

          <small>
            LOUIS13 OFFICIAL
          </small>

          <h3>
            JOIN OUR COMMUNITY
          </h3>

          <p>
            Ikuti komuniti rasmi LOUIS13 untuk
            mendapatkan promosi dan informasi terbaru.
          </p>

        </div>


        <div class="channel-buttons">

          <!-- WHATSAPP CHANNEL -->
          <a
            href="https://joinlouis.wasap.my"
            id="whatsappChannel"
            class="channel-btn whatsapp"
            target="_blank"
            rel="noopener noreferrer"
          >

            <div class="social-icon">
              WA
            </div>

            <div>
              <small>JOIN GROUP</small>
              <strong>WHATSAPP</strong>
            </div>

            <b>›</b>

          </a>


          <!-- TELEGRAM CHANNEL -->
          <a
            href="https://t.me/Louis13_Channel"
            id="telegramChannel"
            class="channel-btn telegram"
            target="_blank"
            rel="noopener noreferrer"
          >

            <div class="social-icon">
              TG
            </div>

            <div>
              <small>JOIN CHANNEL</small>
              <strong>TELEGRAM</strong>
            </div>

            <b>›</b>

          </a>

        </div>

      </div>

    </section>


    <!-- GAME LIST -->
    <section class="section game-section" id="games">

      <div class="section-title">

        <p>
          CHOOSE YOUR GAME
        </p>

        <h2>
          GAME <span>LIST</span>
        </h2>

        <div class="title-line">
          <span></span>
          ◆
          <span></span>
        </div>

        <p class="game-hint">
          Klik game pilihan anda untuk hubungi Customer Service
        </p>

      </div>


      <!-- GAME DIBUAT OTOMATIS OLEH JAVASCRIPT -->
      <div
        class="game-grid"
        id="gameGrid"
      ></div>

    </section>

  </main>


  <!-- FOOTER -->
  <footer>

    <div class="footer-brand">

      <img
        src="image/logo.png"
        alt="LOUIS13"
      >

      <div>
        <strong>LOUIS<span>13</span></strong>
        <small>ROYAL GAME PRESTIGE</small>
      </div>

    </div>


    <div class="footer-line"></div>


    <p>
      © 2026 LOUIS13 • All Rights Reserved
    </p>

  </footer>


  <!-- GAME POPUP -->
  <div
    class="popup-overlay"
    id="gamePopup"
    aria-hidden="true"
  >

    <div class="popup">

      <button
        class="popup-close"
        id="popupClose"
        type="button"
        aria-label="Tutup"
      >
        ×
      </button>


      <div
        class="popup-game-logo"
        id="popupGameLogo"
      ></div>


      <small class="popup-label">
        LOUIS13 ROYAL GAME
      </small>


      <h2 id="popupGameName">
        GAME
      </h2>


      <div class="title-line popup-line">
        <span></span>
        ◆
        <span></span>
      </div>


      <p>
        Pilih Customer Service untuk mula.
      </p>


      <!-- WHATSAPP CUSTOMER SERVICE -->
      <a
        href="https://joinlouis.wasap.my"
        id="popupWhatsapp"
        class="popup-btn whatsapp"
        target="_blank"
        rel="noopener noreferrer"
      >

        <div class="social-icon">
          WA
        </div>

        <div>
          <small>HUBUNGI MELALUI</small>
          <strong>WHATSAPP</strong>
        </div>

        <b>›</b>

      </a>


      <!-- TELEGRAM CUSTOMER SERVICE -->
      <a
        href="https://t.me/Louis13_Admin"
        id="popupTelegram"
        class="popup-btn telegram"
        target="_blank"
        rel="noopener noreferrer"
      >

        <div class="social-icon">
          TG
        </div>

        <div>
          <small>HUBUNGI MELALUI</small>
          <strong>TELEGRAM</strong>
        </div>

        <b>›</b>

      </a>


      <div class="popup-bottom">
        ♛ ROYAL GAME PRESTIGE ♛
      </div>

    </div>

  </div>


  <script src="script.js"></script>

</body>
</html>
